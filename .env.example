# ==============================================================================
# DIGITAL BANKING & FINTECH PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' before running 'docker-compose up'.
# IMPORTANT: NEVER commit '.env' containing real secrets to version control!

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5433
DB_NAME=fintech_banking
DB_USER=banking_admin
DB_PASSWORD=banking_secure_pass_2026

# ------------------------------------------------------------------------------
# Redis Distributed Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Apache Kafka Message Broker Configuration
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ------------------------------------------------------------------------------
# Spring Security & JWT Configuration
# ------------------------------------------------------------------------------
# Secret must be at least 256 bits (32 characters base64/hex) for HMAC-SHA256
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# Application Runtime Configuration
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
FRONTEND_PORT=3002
PROMETHEUS_PORT=9095
LOG_LEVEL=INFO
